@page "/"
@rendermode InteractiveServer

<h1>RadzenFastGrid playground</h1>

<div class="toolbar">
    <label><input type="checkbox" @bind="allowResize" /> AllowColumnResize</label>
    <label><input type="checkbox" @bind="allowSorting" /> AllowSorting</label>
    <label><input type="checkbox" @bind="allowFiltering" /> AllowFiltering</label>
    <label><input type="checkbox" @bind="allowPaging" /> AllowPaging</label>
    <label><input type="checkbox" @bind="allowPicking" /> AllowColumnPicking</label>
    <label><input type="checkbox" @bind="alternating" /> AlternatingRows</label>
    <label>Rows <input type="number" @bind="rowCount" style="width:6rem" min="1" max="100000" /></label>
    <button @onclick="Rebuild">Apply row count</button>
    <button @onclick="ResetWidths">Reset widths</button>
</div>

<div class="stage">
    <RadzenFastGrid TItem="Row" Data="@rows"
                    AllowColumnResize="@allowResize"
                    AllowSorting="@allowSorting"
                    AllowFiltering="@allowFiltering"
                    AllowPaging="@allowPaging"
                    AllowColumnPicking="@allowPicking"
                    AllowAlternatingRows="@alternating"
                    PageSize="25"
                    ShowPagingSummary="true"
                    ColumnResized="@OnColumnResized"
                    Settings="@settings"
                    SettingsChanged="@(s => settings = s)">
        <ChildContent>
            <PropertyColumn TItem="Row" TProp="int" Property="@(x => x.Id)" Title="Id" Width="80px" />
            <PropertyColumn TItem="Row" TProp="string" Property="@(x => x.Name)" Title="Name" Width="220px" />
            <PropertyColumn TItem="Row" TProp="string" Property="@(x => x.Department)" Title="Department" />
            <PropertyColumn TItem="Row" TProp="int" Property="@(x => x.Age)" Title="Age" Width="90px" />
            <PropertyColumn TItem="Row" TProp="DateTime" Property="@(x => x.Hired)" Title="Hired" Format="d" />
            <PropertyColumn TItem="Row" TProp="decimal" Property="@(x => x.Salary)" Title="Salary" Format="C0" />
            <PropertyColumn TItem="Row" TProp="string" Property="@(x => x.Notes)" Title="Notes (not resizable)"
                            Resizable="false" />
        </ChildContent>
    </RadzenFastGrid>
</div>

<div class="readout">@readout</div>

@code {
    bool allowResize = true;
    bool allowSorting = true;
    bool allowFiltering = true;
    bool allowPaging = true;
    bool allowPicking;
    bool alternating = true;
    int rowCount = 500;

    List<Row> rows = Row.Make(500);
    FastGridSettings? settings;
    string readout = "Drag a column edge. The width that comes back is printed here.";

    void Rebuild() => rows = Row.Make(rowCount);

    // Clearing the stored widths is the only way back to the declared ones, which is worth being able
    // to do by hand - a resize that cannot be undone is easy to mistake for a resize that is stuck.
    void ResetWidths()
    {
        settings = null;
        rows = Row.Make(rowCount);
        readout = "Widths reset to what the markup declares.";
    }

    void OnColumnResized(FastGridColumnResizedEventArgs<Row> args) =>
        readout = $"{args.Column.Title} -> {args.Width:F1}px";

    public class Row
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Department { get; set; } = "";
        public int Age { get; set; }
        public DateTime Hired { get; set; }
        public decimal Salary { get; set; }
        public string Notes { get; set; } = "";

        static readonly string[] Departments = ["Engineering", "Sales", "Ops", "Finance", "Support"];

        public static List<Row> Make(int n) => Enumerable.Range(0, n).Select(i => new Row
        {
            Id = i,
            Name = "Person " + i,
            Department = Departments[i % Departments.Length],
            Age = 20 + (i % 45),
            Hired = new DateTime(2010, 1, 1).AddDays(i),
            Salary = 40000m + (i % 1000) * 37m,
            Notes = "Row " + i + " has a long enough note to truncate when the column is narrowed.",
        }).ToList();
    }
}
