@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using Radzen
@typeparam TItem
@typeparam TValue
@namespace Radzen.FastGrid

@if (Visible)
{
<div @ref="element" id="@Id" class="@RootCssClass" style="@Style" tabindex="@(Disabled ? "-1" : $"{TabIndex}")"
     role="combobox" aria-haspopup="grid" aria-expanded="@Open.ToString().ToLowerInvariant()"
     aria-disabled="@Disabled.ToString().ToLowerInvariant()" aria-label="@Label"
     @onclick="@TogglePopup" @onclick:stopPropagation @onkeydown="@OnKeyDown">

    @if (ShowsSelection)
    {
        <span class="rz-dropdown-label rz-inputtext" style="width:100%;">@SelectedText</span>
    }
    else if (!string.IsNullOrEmpty(Placeholder))
    {
        <span class="rz-dropdown-label rz-inputtext rz-placeholder" style="width:100%;">@Placeholder</span>
    }
    else
    {
        <span class="rz-dropdown-label rz-inputtext" style="width:100%;">&nbsp;</span>
    }

    <div class="rz-dropdown-trigger rz-corner-right">
        <span class="notranslate rz-dropdown-trigger-icon rzi rzi-chevron-down"></span>
    </div>

    @* Clicks inside the popup must not reach the drop-down's own onclick, or choosing a row would
       toggle the popup straight back open behind the selection. *@
    <div id="@PopupId" class="@PopupCssClass" style="@PopupStyle"
         @onclick:stopPropagation @onkeydown:stopPropagation>
        <div class="rz-lookup-panel" @onkeydown="@CloseOnEscape">
            @* Built on the first open and kept afterwards. A lookup nobody opens costs nothing - its
               columns are not even registered - but destroying the grid on every close threw away the
               sort, filter and page the user left it on, and made a LoadData source re-query from
               scratch each time the popup was reopened. *@
            @if (built)
            {
                @* Virtualize needs a scrolling ancestor with a bounded height, and the popup has none:
                   without this its spacer rows size themselves to the whole row count and run the popup
                   far off the page. RadzenDropDownDataGrid bounds its own grid for the same reason. *@
                <div style="@(AllowVirtualization ? $"height:{PopupHeight};overflow:auto;" : null)">
                <RadzenFastGrid TItem="TItem" @ref="grid"
                                Data="@Data"
                                Count="@Count"
                                LoadData="@LoadData"
                                AllowSorting="@AllowSorting"
                                AllowFiltering="@AllowFiltering"
                                FilterMode="@FilterMode"
                                AllowPaging="@AllowPaging"
                                PageSize="@PageSize"
                                AllowVirtualization="@AllowVirtualization"
                                ItemSize="@ItemSize"
                                Selection="@SelectedItems"
                                RowClick="@OnRowClick"
                                EmptyTemplate="@EmptyTemplate"
                                CssClass="rz-lookup-panel-grid"
                                ChildContent="@ChildContent" />
                </div>
            }
        </div>
    </div>
</div>
}
