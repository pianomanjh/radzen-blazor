@using System.Collections.Generic
@using Radzen
@using Radzen.Blazor
@namespace Radzen.Blazor.Benchmarks

<RadzenDataGrid @ref="Grid" Data="@Data" TItem="Person" AllowSorting="true" AllowFiltering="true" AllowPaging="true" PageSize="@PageSize">
    <Columns>
        <RadzenDataGridColumn TItem="Person" Property="Id" Title="Id" />
        <RadzenDataGridColumn TItem="Person" Property="FirstName" Title="First name" />
        <RadzenDataGridColumn TItem="Person" Property="LastName" Title="Last name" />
        <RadzenDataGridColumn TItem="Person" Property="Email" Title="Email" />
        <RadzenDataGridColumn TItem="Person" Property="HireDate" Title="Hire date" FormatString="{0:d}" />
        <RadzenDataGridColumn TItem="Person" Property="Salary" Title="Salary" FormatString="{0:C}" />
        <RadzenDataGridColumn TItem="Person" Property="IsManager" Title="Manager" />
        <RadzenDataGridColumn TItem="Person" Property="Status" Title="Status" />
        <RadzenDataGridColumn TItem="Person" Property="Address.City" Title="City" />
        <RadzenDataGridColumn TItem="Person" Property="Address.Country" Title="Country" />
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public IEnumerable<Person> Data { get; set; }
    [Parameter] public int PageSize { get; set; } = 50;

    public RadzenDataGrid<Person> Grid { get; set; }
}
